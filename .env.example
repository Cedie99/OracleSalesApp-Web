# Template for local environment files. Copy, don't edit in place — this file is
# the only .env* that is committed, so it must never contain real keys.
#
# Two files, one per environment. Keys come from the matching Supabase project:
# Project Settings → API Keys.
#
#   .env.local        STAGING  (xhxjbzesuzprwdelrdwh)  ← the everyday default
#   .env.prod.local   PROD     (itpskcyojtpcpjwolieb)  ← read-only debugging
#
# Staging lives in .env.local on purpose: it is the file Next loads implicitly
# for `next build`, `next start` and `next lint`, so anything that forgets to
# name an environment gets the harmless one.
#
#   npm run dev        → staging, green banner
#   npm run dev:prod   → production, red banner
#   npm run env:check  → validate both files without starting a server
#
# scripts/dev-env.mjs refuses to start if a file's URL and keys don't belong to
# the environment it claims, so a bad paste fails loudly instead of writing to
# the wrong database.

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY

# Only needed to exercise the /api/cron/* routes locally; any value works as
# long as you send the same one as `Authorization: Bearer <value>`.
CRON_SECRET=PASTE_ANY_RANDOM_STRING

# BusyBee SMS — powers the "Additional Collection" notification to collectors.
# All four are server-only and all four must be set, or the SMS path stays off
# (the store is still listed; only the SMS is skipped). Values come from the
# BusyBee dashboard. BASE_URL is the gateway host, e.g. https://your-smsc-host
# (the path /api/v2/SendSMS is appended in code — don't include it here).
BUSYBEE_BASE_URL=https://YOUR_SMSC_HOST
BUSYBEE_API_KEY=PASTE_BUSYBEE_API_KEY
BUSYBEE_CLIENT_ID=PASTE_BUSYBEE_CLIENT_ID
BUSYBEE_SENDER_ID=PASTE_APPROVED_SENDER_ID

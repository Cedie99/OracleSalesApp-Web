# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no keys and tells new devs which file
# points at which Supabase project.
!.env.example

# vercel
.vercel

# supabase CLI local cache (project ref, pooler url, version info — regenerated per machine)
/supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# local planning / handoff notes (personal, not shared)
/DEV2_PLAN.md
/SUPABASE_CHANGES_FOR_MOBILE.md

# Claude Code personal overrides — machine-specific paths (the mobile repo
# checkout) that would be wrong on a teammate's box. A shared
# .claude/settings.json is deliberately NOT ignored, so team-wide rules can
# still be committed later.
/.claude/settings.local.json
